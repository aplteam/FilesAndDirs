 R←Test_Misc_009(stopFlag batchFlag);⎕TRAP;appdata;buff;expected
⍝ Test the `NormalizePath` method
 ⎕TRAP←(999 'C' '. ⍝ Deliberate error')(0 'N')
 R←T._Failed

 →T.PassesIf'a'≡##.FilesAndDirs.NormalizePath'a'

 :If 'Win'≡APLTreeUtils2.GetOperatingSystem ⍬
     →T.PassesIf 0=≢##.FilesAndDirs.NormalizePath''
     →T.PassesIf 0=≢'expand'##.FilesAndDirs.NormalizePath''
     →T.PassesIf(##.FilesAndDirs.(EnforceBackslash PWD),'\a')≡'expand'##.FilesAndDirs.NormalizePath'a'
     →T.PassesIf((##.FilesAndDirs.(EnforceBackslash Cd'')),'\a')≡'expand'##.FilesAndDirs.NormalizePath'a'
     →T.PassesIf'abc'≡##.FilesAndDirs.NormalizePath'abc'
     →T.PassesIf'abc\123'≡##.FilesAndDirs.NormalizePath'abc/123'
     →T.PassesIf'abc\123'≡##.FilesAndDirs.NormalizePath'abc/123'
     →T.PassesIf'abc\123'≡##.FilesAndDirs.NormalizePath'abc////123'
     →T.PassesIf'abc\123'≡##.FilesAndDirs.NormalizePath'abc\\\///123'
     →T.PassesIf'\\APLTeam2\abc\123'≡##.FilesAndDirs.NormalizePath'\\APLTeam2\abc\123'    ⍝ Because this is a UNC path!
     →T.PassesIf'\\APLTeam2\abc\123'≡##.FilesAndDirs.NormalizePath'//APLTeam2/abc\123'    ⍝ Not a UNC path but treated as such - what else would it be?!
     appdata←⊃⎕CMD'echo %appdata%'
     →T.PassesIf appdata≡##.FilesAndDirs.NormalizePath'%appdata%'                         ⍝ Env Vars are expanded since 1.5
     expected←'\path2\2\',(2 ⎕NQ #'GetEnvironment' 'USERNAME'),'\foo'
     →T.PassesIf expected≡##.FilesAndDirs.NormalizePath'/path2/2/%USERNAME%/foo'          ⍝ Env Vars are expanded ANYWHERE since 7.1.0
     →T.PassesIf'C:\APLTeam2\abc'≡'expand'##.FilesAndDirs.NormalizePath'C:\APLTeam2/abc/123\..'
     →T.PassesIf'C:\APLTeam2\abc\'≡'expand'##.FilesAndDirs.NormalizePath'C:\APLTeam2/abc/123\..\'
     →T.PassesIf'C:\APLTeam2\abc\1' 'C:\APLTeam2\abc\2'≡'expand'##.FilesAndDirs.NormalizePath'C:\APLTeam2/abc/1' 'C:\APLTeam2/abc/2'
     →T.PassesIf∧/{'C:\'∘≡¨3↑¨⍵}'expand'##.FilesAndDirs.NormalizePath'C:\APLTeam2/abc/1' '%APPDATA%'
     →T.PassesIf('C:\Path\2\',⊃,/{2 ⎕NQ #'GetEnvironment'⍵}¨'USERNAME' 'OS')≡(##.FilesAndDirs.NormalizePath'C:\Path/2/%USERNAME%%OS%')

     ⍝ There is no need for the ¨ ↓ here but it should work anyway, and there was once a bug!
     →T.PassesIf(3⍴⊂buff)≡'expand'∘##.FilesAndDirs.NormalizePath¨3⍴{'..\',⍵}¨¯1↑'\'APLTreeUtils2.Split buff←##.FilesAndDirs.PWD
 :Else
     →T.PassesIf 0=≢##.FilesAndDirs.NormalizePath''
     →T.PassesIf 0=≢'expand'##.FilesAndDirs.NormalizePath''
     →T.PassesIf(##.FilesAndDirs.PWD,'/a')≡'expand'##.FilesAndDirs.NormalizePath'a'
     →T.PassesIf'abc'≡##.FilesAndDirs.NormalizePath'abc'
     →T.PassesIf'abc/123'≡##.FilesAndDirs.NormalizePath'abc/123'
     →T.PassesIf'abc/123'≡##.FilesAndDirs.NormalizePath'abc/123'
     →T.PassesIf'abc/123'≡##.FilesAndDirs.NormalizePath'abc////123'
     →T.PassesIf'abc/123'≡##.FilesAndDirs.NormalizePath'abc\\\///123'
     →T.PassesIf'\\APLTeam2/abc/123'≡##.FilesAndDirs.NormalizePath'\\APLTeam2\abc\123'    ⍝ Because this is a UNC path!
     →T.PassesIf'\\APLTeam2/abc/123'≡##.FilesAndDirs.NormalizePath'//APLTeam2\abc\123'    ⍝ Not a UNC path but treated as such - what else would it be?!
     →T.PassesIf'/APLTeam2/abc'≡'expand'##.FilesAndDirs.NormalizePath'/APLTeam2/abc/123/..'
     →T.PassesIf'/APLTeam2/abc/'≡'expand'##.FilesAndDirs.NormalizePath'/APLTeam2/abc/123/../'
     :If 'Lin'≡APLTreeUtils2.GetOperatingSystem ⍬
         →T.PassesIf∧/'/opt/mdyalog/'{('/APLTeam2/abc/1'≡1⊃⍵)(⍺≡(≢⍺)↑2⊃⍵)}'expand'##.FilesAndDirs.NormalizePath'/APLTeam2\abc/1' '$DYALOG'
         expected←'/home/',2 ⎕NQ #'GetEnvironment' 'USER'
         →T.PassesIf expected≡##.FilesAndDirs.NormalizePath'$HOME'                       ⍝ Env Vars are expanded ANYWHERE since 7.1.0
         expected←'/path/2/',(2 ⎕NQ #'GetEnvironment' 'USER'),'/foo'
         →T.PassesIf expected≡##.FilesAndDirs.NormalizePath'/path/2/$USER/foo'           ⍝ Env Vars are expanded ANYWHERE since 7.1.0/
     :Else
         →T.PassesIf∧/'/Applications/Dyalog'{('/APLTeam2/abc/1'≡1⊃⍵)(⍺≡(≢⍺)↑2⊃⍵)}'expand'##.FilesAndDirs.NormalizePath'/APLTeam2\abc/1' '$DYALOG'
         expected←'/Users/',2 ⎕NQ #'GetEnvironment' 'USER'
         →T.PassesIf expected≡##.FilesAndDirs.NormalizePath'$HOME'                       ⍝ Env Vars are expanded ANYWHERE since 7.1.0
         expected←'/path/2/',(2 ⎕NQ #'GetEnvironment' 'USER'),'/foo'
         →T.PassesIf expected≡##.FilesAndDirs.NormalizePath'/path/2/$USER/foo'           ⍝ Env Vars are expanded ANYWHERE since 7.1.0
     :EndIf
     expected←'/path/2/',(⊃⎕SH'echo $USER'),'/',(⊃⎕SH'echo $LOGNAME'),'/$DOES_NOT_EXIST'
     →T.PassesIf expected≡##.FilesAndDirs.NormalizePath'/path/2/$USER/$LOGNAME/$DOES_NOT_EXIST'
 :EndIf

 R←T._OK
