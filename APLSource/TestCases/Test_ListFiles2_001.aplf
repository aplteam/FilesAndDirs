 R←Test_ListFiles2_001(stopFlag batchFlag);⎕TRAP;list;parms
⍝ Test the `ListFiles2` method
 ⎕TRAP←(999 'C' '. ⍝ Deliberate error')(0 'N')
 R←T._Failed

 list←##.FilesAndDirs.ListFiles2 ∆Home
 →T.PassesIf 0=≢list

 parms←⎕ns''
 parms.recurse←2
 list←parms ##.FilesAndDirs.ListFiles2 ∆Home
 →T.PassesIf 2<≢list
 →T.PassesIf∧/##.FilesAndDirs.IsFile¨list

 →T.PassesIf 1=≢##.FilesAndDirs.ListFiles2 ∆Home,'/Second/Sub_b/*_ab'

 :Trap 11
     {}##.FilesAndDirs.ListFiles2 ∆Home,'/Sec*/Sub'
     →T.FailsIf 1
 :Else
     →T.PassesIf'Wildcard characters are allowed only in the last part of a path'≡⊃⎕DM
 :EndTrap

 :Trap 11
     {}##.FilesAndDirs.ListFiles2 ∆Home,'/DoesNotExist/Sub'
     →T.FailsIf 1
 :Else
     →T.PassesIf'Right argument is not a directory'≡⊃⎕DM
 :EndTrap

 R←T._OK
